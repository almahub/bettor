BETTER_DATABASE_URL=sqlite:///data/better.db
BETTER_SYSTEM_TWO_ENABLED=false
SYSTEM_ONE_ENABLED=false
SYSTEM_ONE_PROVIDER=rizzo_flow
SYSTEM_ONE_SHADOW_MODE=true
SYSTEM_ONE_PRE_SCREEN_ENABLED=true
SYSTEM_ONE_ROUTING_ENABLED=true
SYSTEM_ONE_CONSISTENCY_ENABLED=true
SYSTEM_ONE_ESCALATION_ENABLED=true
RIZZO_FLOW_BASE_URL=http://127.0.0.1:8017
RIZZO_FLOW_MODEL=
RIZZO_FLOW_TIMEOUT_MS=3000
RIZZO_FLOW_MAX_RETRIES=1
RIZZO_FLOW_API_KEY=
RIZZO_FLOW_MODEL_FINGERPRINT=
# Select providers in config/sources.yaml. These values never enable synthetic data.
BETTER_FEED_BASE_URL=
BETTER_FEED_API_KEY=
FOOTBALL_DATA_ORG_API_KEY=
# API-Football provider reads this key from environment or local .env.
API_FOOTBALL_API_KEY=
# Sportradar Soccer v4 provider reads this key from environment or local .env.
SPORTRADAR_API_KEY=
BETTER_HISTORY_FILE=
BETTER_PORTFOLIO_FILE=
# Targeted web research (Phase 1: NEWS, shadow/visibility only).
EXTERNAL_RESEARCH_ENABLED=false
RESEARCH_PRIMARY_SOURCE=true
EXTERNAL_RESEARCH_PROVIDER=openai
OPENAI_API_KEY=
# Saved agent transport (default). The saved agent owns model, instructions,
# reasoning, verbosity and Web Search configuration.
OPENAI_RESEARCH_USE_AGENTS_API=true
OPENAI_RESEARCH_TRANSPORT=agents_api
OPENAI_RESEARCH_AGENT_ID=
OPENAI_FOOTBALL_DATA_AGENT_ID=
FOOTBALL_DATA_RESEARCH_ENABLED=true
# Optional failover after an Agents API failure: responses_api or empty.
OPENAI_RESEARCH_FALLBACK_TRANSPORT=
# Used only by responses_api, never as an override for a saved agent.
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
OPENAI_RESEARCH_FALLBACK_MODEL=
OPENAI_RESEARCH_WEB_SEARCH_CONTEXT_SIZE=low
OPENAI_RESEARCH_TIMEOUT_SECONDS=30
OPENAI_RESEARCH_MAX_REQUESTS_PER_MATCH=1
OPENAI_RESEARCH_MAX_SEARCH_CALLS=3
OPENAI_RESEARCH_MAX_TOKENS_PER_MATCH=8000
OPENAI_RESEARCH_MAX_OUTPUT_TOKENS=2500
OPENAI_RESEARCH_MAX_COST_PER_MATCH=0.25
# Optional overrides. Defaults follow the documented gpt-5.6-luna token rates
# and $0.01 per Web Search call; set them when selecting another model.
OPENAI_RESEARCH_INPUT_COST_PER_MILLION=
OPENAI_RESEARCH_OUTPUT_COST_PER_MILLION=
OPENAI_RESEARCH_WEB_SEARCH_COST_PER_CALL=
# API control: an Organization Owner creates this separate Admin API key.
# Without it, Better reads the sanitized JSON exports in data/api-control/.
OPENAI_ADMIN_KEY=
OPENAI_USAGE_LIVE_ENABLED=false
# Optional fixed fallback; normally Better reads the ECB daily USD→EUR reference conversion.
OPENAI_COST_USD_EUR_RATE=

# Central data-pipeline storage policy. Immutable database records are never
# removed by retention; the windows apply only to raw files and caches.
BETTER_STORAGE_MAX_GB=5
BETTER_RAW_RETENTION_DAYS=30
BETTER_CACHE_RETENTION_DAYS=7
BETTER_PIPELINE_AUTO_COLLECT=true
BETTER_PIPELINE_POLL_SECONDS=1800
BETTER_VALIDATION_COHORT_ENABLED=true
BETTER_VALIDATION_COHORT_AUTO_ENROLL=true
BETTER_VALIDATION_CANONICAL_CHECKPOINT=T6
BETTER_VALIDATION_CANONICAL_FALLBACK=T24
BETTER_VALIDATION_RESULT_POLL_ENABLED=true
BETTER_VALIDATION_LIVE_FORWARD_REQUIRED=true
BETTER_VALIDATION_RESEARCH_BUDGET_PER_MATCH=0.25
BETTER_VALIDATION_RESEARCH_BUDGET_PER_DAY=5.0
BETTER_VALIDATION_RESEARCH_BUDGET_PER_WEEK=25.0
# Optional explicit allowlist for non-888 fixture providers, encoded as a YAML list.
BETTER_VALIDATION_VERIFIED_COMPETITIONS=[]
